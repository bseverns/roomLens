#X obj 32 352 expr 1000/max($f1\, 0.2);
#X obj 32 382 metro 200;
#X obj 92 382 t b b;
#X obj 92 412 r env_attack_ms;
#X obj 92 442 pack f f;
#X msg 92 472 0\, 1 $1\, 0 200 $1;
#X obj 92 502 vline~;
