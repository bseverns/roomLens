#N canvas 70 62 1100 820 10;
#X text 28 20 Room Lens Pd patch — listens for /roomlens OSC pairs and maps them to a tiny synth (mirrors host/supercollider/RoomLens.scd).;
#X text 28 36 Run python host with --osc 57120 or replay_example_data.py to feed axes.;
#X obj 32 80 netreceive -u -b 57120;
#X obj 32 110 oscparse;
#X obj 32 140 list trim;
#X obj 32 170 route roomlens;
#X text 210 170 OSC bundle shape: /roomlens grain_density 5 filter_cutoff_hz 900 ...;
#X obj 32 210 unpack s f s f s f s f s f s f s f s f s f s f;
